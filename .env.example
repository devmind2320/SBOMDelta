# Copy to .env and fill in from your GitHub App's settings page.
# docker-compose reads this file automatically.

# GitHub App -> Settings -> "App ID"
GITHUB_APP_ID=

# The URL slug of the app, used only for building links back to it.
GITHUB_APP_SLUG=sbomdelta

# The secret you entered in the app's "Webhook secret" field. Required:
# without it webhook signatures cannot be verified and the server refuses
# to start.
GITHUB_WEBHOOK_SECRET=

# The private key downloaded when the app was created. Save it to
# ./secrets/github-app.pem -- docker-compose mounts it into both services.
# Outside Docker, either point at the file or paste the PEM inline:
#   GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
#   GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n"
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
