# Copy to .env and fill in from your GitHub App's settings page.
# docker-compose reads this file automatically.

# GitHub App -> Settings -> "App ID"
GITHUB_APP_ID=

# The URL slug of the app, used only for building links back to it.
GITHUB_APP_SLUG=sbomdelta

# The secret you entered in the app's "Webhook secret" field. Required:
# without it webhook signatures cannot be verified and the server refuses
# to start.
GITHUB_WEBHOOK_SECRET=

# Optional. Leave empty for a multi-user deployment: any installation a
# signed-in user has connected is scanned. Set it to a comma-separated list
# of GitHub numeric account IDs (users or organizations), never logins, which
# can be renamed, to scan only installations on those accounts. Find an
# account's ID with
#   curl -s https://api.github.com/users/<login> | grep '"id"'
ALLOWED_INSTALLATION_ACCOUNTS=

# The private key downloaded when the app was created. Save it to
# ./secrets/github-app.pem -- docker-compose mounts it into both services.
# Outside Docker, either point at the file or paste the PEM inline:
#   GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem

# ---------------------------------------------------------- dashboard sign-in
# People sign in with the GitHub App's own user authorization. These are read
# by the API server only; none has a default that would open the dashboard.

# docker-compose sets AUTH_DISABLED=true by default so the stack starts with
# no GitHub setup at all; every request is then treated as signed in. It is
# refused unless APP_ENV=development. Set it to false to test sign-in.
# AUTH_DISABLED=false

# GitHub App -> Settings -> "Client ID".
GITHUB_CLIENT_ID=

# GitHub App -> Settings -> "Generate a new client secret". Save it to
# ./secrets/github-client-secret (docker-compose mounts ./secrets), or outside
# Docker point at the file or set it inline:
#   GITHUB_CLIENT_SECRET_PATH=./secrets/github-client-secret
#   GITHUB_CLIENT_SECRET=...
GITHUB_CLIENT_SECRET_PATH=./secrets/github-client-secret

# The origin browsers use to reach the dashboard. The App's "Callback URL"
# must be this plus /api/auth/github/callback. In development that is the
# Vite dev server, which proxies /api to the Go API. Write it exactly as a
# browser sends it -- lowercase, no default port (:443/:80), no path -- or the
# server refuses to start.
PUBLIC_URL=http://localhost:5173

# Optional. Leave empty to let any GitHub account sign in; each sees only the
# repositories GitHub lets it reach through the App. Set it to a
# comma-separated list of GitHub logins to refuse everyone else.
ALLOWED_GITHUB_LOGINS=

# How long a sign-in lasts (Go duration, 5m to 720h). Default 12h.
# SESSION_TTL=12h
#   GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n"
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem

# ------------------------------------------------- vulnerability intelligence
# The worker checks every scan's components against the public OSV.dev API
# (https://api.osv.dev, no credentials). It needs outbound HTTPS to that host.
# Set true to work offline; scans then say they were not checked.
# OSV_DISABLED=false
# OSV_API_BASE_URL=https://api.osv.dev
