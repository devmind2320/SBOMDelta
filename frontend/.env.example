# Where the Go API lives. In development Vite proxies /api to this target, so
# the browser only ever talks to the dev server's own origin.
VITE_API_TARGET=http://localhost:8080

# The API must stay on the dashboard's own origin: sign-in uses a same-site
# session cookie and the API sends no CORS headers. VITE_API_BASE can add a
# path prefix, but pointing it at another host will not work.
# VITE_API_BASE=
